# Copy to .env.local and fill in from Supabase: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy anon key also works via
# NEXT_PUBLIC_SUPABASE_ANON_KEY. NEVER put the secret/service_role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: map tiles. The public OpenStreetMap server is fine for development
# and light use only; use a tile provider for production traffic.
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
